{
  "id": "northline-station-boards",
  "version": "0.1.0",
  "family": "channel-cover",
  "title": "Northline Transit station boards",
  "description": "Square, wide, and tall station screens. Technical slot list only. synthetic-authorized-substitute.",
  "naming": {
    "pattern": "^board-(square|wide|tall)\\.(png|jpe?g)$"
  },
  "transparencyAllowed": false,
  "slots": [
    {
      "id": "board-square",
      "path": "board-square.png",
      "aspect": "1:1",
      "format": "png",
      "width": 90,
      "height": 90,
      "required": true
    },
    {
      "id": "board-wide",
      "path": "board-wide.jpg",
      "aspect": "3:1",
      "format": "jpeg",
      "width": 180,
      "height": 60,
      "required": true
    },
    {
      "id": "board-tall",
      "path": "board-tall.png",
      "aspect": "1:3",
      "format": "png",
      "width": 60,
      "height": 180,
      "required": true
    }
  ]
}
