{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openadam:procedure:batch-delivery.preflight:v0.1:input",
  "title": "Batch delivery preflight input",
  "type": "object",
  "additionalProperties": false,
  "required": ["root"],
  "properties": {
    "root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Campaign directory relative to the implementation root. Kit roots are resolved inside it. File Vitals inspect grants stay per kit, not this directory."
    },
    "workspaceRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "adapter": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "specPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "oneOf": [
    { "required": ["spec"] },
    { "required": ["specPath"] }
  ],
  "$defs": {
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "kits"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "family": { "const": "batch-delivery" },
        "kits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/kit" }
        }
      }
    },
    "kit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "required", "root"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "kind": { "enum": ["asset-delivery", "channel-cover"] },
        "required": { "type": "boolean" },
        "root": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "specPath": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "spec": { "type": "object" }
      }
    }
  }
}
