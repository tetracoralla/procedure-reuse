{
  "schemaVersion": "openadam.agent-tool-project.v0.1",
  "id": "org.openadam.batch-delivery-preflight",
  "version": "0.1.0",
  "name": "Batch delivery preflight",
  "summary": "Read-only two-layer preflight: dispatch each campaign kit to asset-delivery-preflight or channel-cover-preflight. Observation is file.inspect. Does not implement raster.verify.",
  "documents": {
    "productModel": "docs/PRODUCT_MODEL.md",
    "reviewContract": "docs/REVIEW_CONTRACT.md"
  },
  "checks": [
    {
      "id": "development",
      "lane": "development-regression",
      "command": {
        "executable": "node",
        "args": ["scripts/kit-development-check.mjs"],
        "timeoutMs": 180000
      }
    },
    {
      "id": "procedure-result-boundary",
      "lane": "procedure-conformance",
      "command": {
        "executable": "sh",
        "args": ["scripts/run-procedure-conformance.sh"],
        "timeoutMs": 180000
      }
    }
  ],
  "carriers": [
    { "kind": "cli", "path": "src/cli.mjs" },
    { "kind": "cli", "path": "procedure/adapter.mjs" },
    { "kind": "mcp", "path": "src/mcp-server.mjs" },
    { "kind": "skill", "path": "plugins/batch-delivery-preflight/skills/batch-delivery-preflight/SKILL.md" },
    { "kind": "codex-plugin", "path": "plugins/batch-delivery-preflight/.codex-plugin/plugin.json" }
  ],
  "contracts": {
    "procedureImplementationManifest": "procedure/implementation-manifest.json"
  },
  "package": {
    "componentId": "batch-delivery-preflight",
    "command": {
      "executable": "node",
      "args": ["scripts/package-component.mjs"],
      "timeoutMs": 120000
    },
    "artifact": "dist/batch-delivery-preflight-0.1.0.tar.gz",
    "integration": "packaging/agent-host-integration.json",
    "legal": {
      "spdx": "Apache-2.0",
      "license": "LICENSE",
      "notice": "NOTICE",
      "thirdPartyNotices": "THIRD_PARTY_NOTICES.txt",
      "sbom": "sbom.spdx.json"
    },
    "probes": [
      {
        "id": "missing-cover-kit",
        "tool": "batch_delivery_preflight",
        "arguments": {
          "root": "fixtures/missing-covers",
          "specPath": "specs/good.json"
        },
        "expectation": "success",
        "effects": "read-only"
      },
      {
        "id": "invalid-input",
        "tool": "batch_delivery_preflight",
        "arguments": {},
        "expectation": "protocol-error",
        "effects": "read-only"
      }
    ]
  }
}
