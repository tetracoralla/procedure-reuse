{
  "id": "kiosk-posters",
  "version": "0.1.0",
  "family": "channel-cover",
  "title": "Kiosk posters",
  "description": "Square, wide, and tall posters. Technical slot list only.",
  "naming": {
    "pattern": "^poster-(square|wide|tall)\\.(png|jpe?g)$"
  },
  "transparencyAllowed": false,
  "slots": [
    {
      "id": "poster-square",
      "path": "poster-square.png",
      "aspect": "1:1",
      "format": "png",
      "width": 80,
      "height": 80,
      "required": true
    },
    {
      "id": "poster-wide",
      "path": "poster-wide.jpg",
      "aspect": "16:9",
      "format": "jpeg",
      "width": 192,
      "height": 108,
      "required": true
    },
    {
      "id": "poster-tall",
      "path": "poster-tall.png",
      "aspect": "9:16",
      "format": "png",
      "width": 108,
      "height": 192,
      "required": true
    }
  ]
}
