{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openadam:procedure:asset-delivery.preflight:v0.1:input",
  "title": "Asset delivery preflight input",
  "type": "object",
  "additionalProperties": false,
  "required": ["root"],
  "properties": {
    "root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Delivery directory relative to the implementation root. Becomes the File Vitals workspace grant. Slot paths are relative to this directory."
    },
    "workspaceRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Optional explicit File Vitals grant, relative to the implementation root. Defaults to the resolved delivery root."
    },
    "adapter": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Optional path to the File Vitals capability-jsonl adapter binary. Defaults to bin/capability-adapter in the implementation root."
    },
    "specPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Relative path to a slot spec JSON file inside the implementation root."
    },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "oneOf": [
    { "required": ["spec"] },
    { "required": ["specPath"] }
  ],
  "$defs": {
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slots"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "alphaPolicy": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "properties": {
            "present": { "type": "string" },
            "absent": { "type": "string" },
            "any": { "type": "string" },
            "unknown": { "type": "string" }
          }
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/slot" }
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "format", "width", "height", "alpha", "required"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "format": { "enum": ["png", "jpeg", "gif", "webp"] },
        "width": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "height": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "alpha": { "enum": ["present", "absent", "any", "unknown"] },
        "required": { "type": "boolean" }
      }
    }
  }
}
