{
  "schemaVersion": "openadam.agent-tool-project.v0.1",
  "id": "org.openadam.asset-delivery-preflight",
  "version": "0.1.0",
  "name": "Asset delivery preflight",
  "summary": "Read-only suite preflight for asset-delivery slots. Observes each present file with org.openadam.file.inspect@0.1.0 (File Vitals) and compares name, format, width, height, alpha, missing, and extra in ordinary code. Does not implement raster.verify.",
  "documents": {
    "productModel": "docs/PRODUCT_MODEL.md",
    "reviewContract": "docs/REVIEW_CONTRACT.md"
  },
  "checks": [
    {
      "id": "development",
      "lane": "development-regression",
      "command": {
        "executable": "node",
        "args": ["scripts/kit-development-check.mjs"],
        "timeoutMs": 180000
      }
    },
    {
      "id": "procedure-result-boundary",
      "lane": "procedure-conformance",
      "command": {
        "executable": "sh",
        "args": ["scripts/run-procedure-conformance.sh"],
        "timeoutMs": 180000
      }
    }
  ],
  "carriers": [
    { "kind": "cli", "path": "preflight.mjs" },
    { "kind": "cli", "path": "procedure/adapter.mjs" },
    { "kind": "mcp", "path": "src/mcp-server.mjs" },
    { "kind": "skill", "path": "plugins/asset-delivery-preflight/skills/asset-delivery-preflight/SKILL.md" },
    { "kind": "codex-plugin", "path": "plugins/asset-delivery-preflight/.codex-plugin/plugin.json" }
  ],
  "contracts": {
    "procedureImplementationManifest": "procedure/implementation-manifest.json"
  },
  "package": {
    "componentId": "asset-delivery-preflight",
    "command": {
      "executable": "node",
      "args": ["scripts/package-component.mjs"],
      "timeoutMs": 120000
    },
    "artifact": "dist/asset-delivery-preflight-0.1.0.tar.gz",
    "integration": "packaging/agent-host-integration.json",
    "legal": {
      "spdx": "Apache-2.0",
      "license": "LICENSE",
      "notice": "NOTICE",
      "thirdPartyNotices": "THIRD_PARTY_NOTICES.txt",
      "sbom": "sbom.spdx.json"
    },
    "probes": [
      {
        "id": "empty-root-missing-slot",
        "tool": "asset_delivery_preflight",
        "arguments": {
          "root": ".",
          "spec": {
            "id": "probe-empty",
            "slots": [
              {
                "id": "icon-16",
                "path": "icon-16.png",
                "name": "icon-16.png",
                "format": "png",
                "width": 16,
                "height": 16,
                "alpha": "present",
                "required": true
              }
            ]
          }
        },
        "expectation": "success",
        "effects": "read-only"
      },
      {
        "id": "invalid-input",
        "tool": "asset_delivery_preflight",
        "arguments": {},
        "expectation": "protocol-error",
        "effects": "read-only"
      }
    ]
  }
}
