{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openadam:procedure:compose-preflight:v0.1:input",
  "title": "Compose preflight input (scaffold; author tightens)",
  "type": "object",
  "additionalProperties": false,
  "required": ["root"],
  "properties": {
    "root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "workspaceRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "adapter": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "specPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "oneOf": [
    { "required": ["spec"] },
    { "required": ["specPath"] }
  ],
  "$defs": {
    "spec": {
      "type": "object",
      "additionalProperties": true,
      "required": ["slots"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "slots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/slot" }
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "path", "required"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "required": { "type": "boolean" }
      }
    }
  }
}
