{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openadam:procedure:channel-cover.preflight:v0.1:input",
  "title": "Channel cover preflight input",
  "type": "object",
  "additionalProperties": false,
  "required": ["root"],
  "properties": {
    "root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "description": "Delivery directory relative to the implementation root. Becomes the File Vitals workspace grant. Slot paths are relative to this directory."
    },
    "workspaceRoot": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "adapter": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "specPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "oneOf": [
    { "required": ["spec"] },
    { "required": ["specPath"] }
  ],
  "$defs": {
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["family", "naming", "transparencyAllowed", "slots"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "family": { "const": "channel-cover" },
        "naming": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pattern"],
          "properties": {
            "pattern": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        },
        "transparencyAllowed": { "type": "boolean" },
        "slots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/slot" }
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "aspect", "format", "width", "height", "required"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 160 },
        "path": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "name": { "type": "string", "minLength": 1, "maxLength": 256 },
        "aspect": { "type": "string", "pattern": "^[1-9][0-9]{0,4}:[1-9][0-9]{0,4}$" },
        "format": { "enum": ["png", "jpeg", "gif", "webp"] },
        "width": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "height": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "required": { "type": "boolean" }
      }
    }
  }
}
